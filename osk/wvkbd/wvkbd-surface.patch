+static const char *
+kbd_key_label(struct key *k, bool shift, bool altgr)
+{
+    if (altgr)
+        return shift ? k->altgr_shift_label : k->altgr_label;
+    return shift ? k->shift_label : k->label;
+}
+
+/* a hint is worth drawing unless it is empty or only a case change */
+static bool
+kbd_hint_useful(const char *hint, const char *label)
+{
+    if (!hint || !*hint || !label)
+        return false;
+    gchar *a = g_utf8_casefold(hint, -1), *b = g_utf8_casefold(label, -1);
+    bool useful = strcmp(a, b) != 0;
+    g_free(a);
+    g_free(b);
+    return useful;
+}
+
+/* draw the characters of the other shift and AltGr levels in the key corners */
+static void
+kbd_draw_hints(struct kbd *kb, struct key *k, const char *label, Color color,
+               bool shift, bool altgr)
+{
+    struct clr_scheme *scheme = &kb->schemes[k->scheme];
+    const char *shift_hint = kbd_key_label(k, !shift, altgr);
+    const char *altgr_hint = kbd_key_label(k, shift, !altgr);
+
+    color.bgra[3] = color.bgra[3] * 3 / 5;
+    if (kbd_hint_useful(shift_hint, label))
+        drw_draw_corner_text(kb->surf, color, k->x, k->y, k->w, k->h,
+                             KBD_KEY_BORDER, false, shift_hint,
+                             scheme->hint_font_description);
+    if (kbd_hint_useful(altgr_hint, label))
+        drw_draw_corner_text(kb->surf, color, k->x, k->y, k->w, k->h,
+                             KBD_KEY_BORDER, true, altgr_hint,
+                             scheme->hint_font_description);
+}
