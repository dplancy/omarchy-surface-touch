diff --git i/drw.c w/drw.c
index 89ec8d8..d5a0f55 100644
--- i/drw.c
+++ w/drw.c
@@ -155,6 +155,37 @@ drw_draw_text(struct drwsurf *ds, Color color, uint32_t x, uint32_t y,
     cairo_restore(d->cairo);
 }
 
+void
+drw_draw_corner_text(struct drwsurf *ds, Color color, uint32_t x, uint32_t y,
+                     uint32_t w, uint32_t h, uint32_t b, bool right,
+                     const char *label, PangoFontDescription *font_description)
+{
+    drwsurf_flip(ds);
+    struct drwbuf *d = ds->back_buffer;
+    drwsurf_damage(ds, x, y, w, h);
+
+    cairo_save(d->cairo);
+
+    pango_layout_set_font_description(d->layout, font_description);
+
+    cairo_set_source_rgba(
+        d->cairo, color.bgra[2] / (double)255, color.bgra[1] / (double)255,
+        color.bgra[0] / (double)255, color.bgra[3] / (double)255);
+
+    pango_layout_set_text(d->layout, label, -1);
+    pango_layout_set_width(d->layout, -1);
+    pango_layout_set_height(d->layout, -1);
+
+    int width, height;
+    pango_layout_get_pixel_size(d->layout, &width, &height);
+
+    uint32_t pad = b + h / 12;
+    cairo_move_to(d->cairo, right ? x + w - pad - width : x + pad, y + pad / 2);
+
+    pango_cairo_show_layout(d->cairo, d->layout);
+    cairo_restore(d->cairo);
+}
