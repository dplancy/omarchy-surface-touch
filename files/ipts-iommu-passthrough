#!/bin/sh
# Called by /etc/modprobe.d/ipts-iommu.conf right before mei_me is loaded.
#
# linux-omarchy enables the Intel IOMMU by default, which blocks the DMA buffers
# used by IPTS (DMAR faults on the touch controller). linux-surface patches the
# kernel to use passthrough for this device; here we do the same from sysfs by
# switching only the IPTS controller's IOMMU group to "identity". The group type
# can only change while no driver is bound, hence the modprobe hook.

# MEI controllers used by IPTS on Surface Pro 4/5/6, Surface Book 1/2, Surface Laptop 1/2
IDS="0x8086:0x9d3e"

for dev in /sys/bus/pci/devices/*; do
	id="$(cat "$dev/vendor"):$(cat "$dev/device")"
	case " $IDS " in *" $id "*) ;; *) continue ;; esac

	group="$dev/iommu_group/type"
	[ -w "$group" ] || continue
	[ "$(cat "$group")" = identity ] && continue

	echo identity > "$group" ||
		logger -t ipts-iommu "failed to set IOMMU group of ${dev##*/} to identity"
done

exit 0
