[Unit]
Description=Automatic brightness for Surface tablets (omarchy-surface-touch)
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionPathExists=/sys/bus/iio/devices

[Service]
Type=simple
ExecStart=%h/.local/lib/omarchy-surface-light/omarchy-surface-light daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
